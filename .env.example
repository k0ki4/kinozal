# Скопируй этот файл в .env и заполни.

# Порт, на котором слушает сервер
PORT=3000

# Длинная случайная строка. Сгенерировать: npm run secret
SESSION_SECRET=

# Аккаунты. Формат: логин:хэш_пароля
# Хэш сделать так: npm run hash -- "длинный-пароль"
USER_1=me:scrypt.xxx.yyy
USER_1_NAME=Я
USER_2=kot:scrypt.xxx.yyy
USER_2_NAME=Коть

# База данных для дневника, хотелок, чата и статистики (бесплатный Neon).
# Нужна на бесплатном Render — иначе всё стирается, когда сайт засыпает.
# Пусто — данные хранятся в файлах в папке data (подходит для своего компьютера и VPS).
DATABASE_URL=

# Сколько дней помнить вход
SESSION_DAYS=30

# Папка для данных (чат, очередь, загруженные файлы, кэш YouTube)
DATA_DIR=./data

# Загрузка своих файлов на сервер (on/off). На бесплатном хостинге лучше off.
UPLOADS=on
MAX_UPLOAD_MB=4096

# ---- YouTube «через сервер» (только на своём VPS) ----
# on — включить режим, off — кнопка будет неактивной
YTDLP=off
YTDLP_BIN=yt-dlp
# Прокси для yt-dlp, если YouTube просит «подтвердить, что вы не бот».
# Пример: http://логин:пароль@адрес:порт  или  socks5://адрес:порт
YTDLP_PROXY=
# Необязательно: файл cookies YouTube (формат Netscape) — тоже помогает от проверки на бота
YTDLP_COOKIES=
# Если вместо Deno хочешь, чтобы yt-dlp использовал Node: node
YTDLP_JS_RUNTIME=
# Качество: по умолчанию до 1080p
YTDLP_FORMAT=bv*[height<=1080][ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b
# Качество для остальных сайтов
YTDLP_FORMAT_OTHER=bv*[height<=1080]+ba/b[height<=1080]/b
# Сколько гигабайт держать в кэше (старые ролики удаляются сами)
CACHE_MAX_GB=20
# Какую звуковую дорожку качать «через сервер», если их несколько: ru, en, ja… Пусто — оригинальную
YTDLP_AUDIO_LANG=
